# Qlinic — variáveis de ambiente (SOMENTE placeholders)
# Variáveis VITE_* são embutidas no bundle do navegador: são PÚBLICAS. Nunca coloque segredo nelas.

# --- Público (frontend) ---
VITE_APP_ENV=demo
VITE_PLATFORM_ROOT_DOMAIN=dominio-da-plataforma.exemplo
# Supabase: URL e chave PUBLICÁVEL (sb_publishable_…). Sem elas o app roda só em demonstração.
# A chave publicável é pública por design; a segurança vem da RLS (supabase/migrations).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Futuro: chave pública VAPID para Web Push
VITE_VAPID_PUBLIC_KEY=

# --- Operação local (scripts/ops — nunca no navegador, nunca com prefixo VITE_) ---
# SUPABASE_PROJECT_ID=
# SUPABASE_ACCESS_TOKEN=        # token pessoal da Supabase (migrações, deploy de funções)
# SUPABASE_SERVICE_ROLE_KEY=    # sb_secret_… (testes/seed; jamais no frontend)
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=

# --- Segredos das Edge Functions (definidos por npm run fn:deploy como secrets do Supabase) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# QLINIC_AI_MONTHLY_LIMIT=1500

# --- Ainda não integrados ---
# RESEND_API_KEY=
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# INFINITEPAY_CLIENT_ID=
# INFINITEPAY_CLIENT_SECRET=
# VAPID_PRIVATE_KEY=
