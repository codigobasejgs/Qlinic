# Qlinic — variáveis de ambiente (SOMENTE placeholders)
# Variáveis VITE_* são embutidas no bundle do navegador: são PÚBLICAS. Nunca coloque segredo nelas.

# --- Público (frontend) ---
VITE_APP_ENV=demo
VITE_PLATFORM_ROOT_DOMAIN=dominio-da-plataforma.exemplo
# Futuro: URL e anon key do Supabase (anon key é pública por design; a segurança vem da RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Futuro: chave pública VAPID para Web Push
VITE_VAPID_PUBLIC_KEY=

# --- Servidor (FUTURO — nunca no navegador, nunca com prefixo VITE_) ---
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# INFINITEPAY_CLIENT_ID=
# INFINITEPAY_CLIENT_SECRET=
# VAPID_PRIVATE_KEY=
