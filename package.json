{
  "name": "qlinic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Qlinic — ERP SaaS multi-tenant para clínicas (frontend de demonstração)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icons": "node scripts/gen-tenant-pwa.mjs --png",
    "manifests": "node scripts/gen-tenant-pwa.mjs",
    "db:migrate": "node scripts/ops/migrate.mjs",
    "db:test-rls": "node scripts/ops/test-rls.mjs",
    "db:seed-demo": "node scripts/ops/seed-demo.mjs",
    "fn:deploy": "node scripts/ops/deploy-functions.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
